# Node & Server Settings
NODE_ENV=production
PORT=10000
HOST=0.0.0.0

# CORS & Domain Settings
FRONTEND_URL=https://your-app.vercel.app
COOKIE_DOMAIN=

# Neon PostgreSQL Database Connection
# Obtain from Neon Dashboard: https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-cool-db-123456.us-east-2.aws.neon.tech/slack_clone?sslmode=require

# Upstash Redis Cache & PubSub Connection
# Obtain from Upstash Dashboard: https://console.upstash.com
REDIS_URL=rediss://default:password@cool-redis-12345.upstash.io:6379

# JWT Authentication Secrets (Min 32 random characters)
JWT_ACCESS_SECRET=your_production_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret_min_32_chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
RESET_PASSWORD_TOKEN_EXPIRES_IN=1h

# Cloudflare R2 / S3 Object Storage Credentials
# Obtain from Cloudflare R2 Dashboard: https://dash.cloudflare.com
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=slack-clone-uploads
R2_PUBLIC_URL=https://pub-yourbucket.r2.dev

# WebRTC STUN / TURN Configuration
STUN_SERVERS=stun:stun.l.google.com:19302
TURN_SERVER_URL=turn:turn.yourdomain.com:3478?transport=udp
TURN_USERNAME=your_turn_username
TURN_CREDENTIAL=your_turn_credential
